{
  "name": "aphrosyne-atlas",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "optimize:assets": "node scripts/optimize-static-assets.mjs",
    "setup:local-assets": "node scripts/setup-local-assets.mjs",
    "generate:content-registry": "node scripts/generate-knowledge-registry.mjs",
    "generate:search-index": "node scripts/generate-search-index.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "test:content-schema": "node scripts/verify-content-fixtures.mjs",
    "dev": "npm run optimize:assets && npm run generate:content-registry && npm run generate:search-index && next dev",
    "build": "npm run optimize:assets && npm run test:content-schema && npm run verify:content && npm run generate:content-registry && npm run generate:search-index && next build",
    "build:static": "node scripts/build-static.mjs",
    "preview:static": "node scripts/preview-static.mjs",
    "smoke:static": "node scripts/smoke-static.mjs",
    "verify:images": "node scripts/verify-image-dimensions.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.3.5",
    "@types/mdx": "^2.0.13",
    "framer-motion": "^12.40.0",
    "gray-matter": "^4.0.3",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "globby": "^16.2.0",
    "sharp": "^0.35.4",
    "subset-font": "^2.7.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
