# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/public/search-index.json
# Complete font sources stay local. The generated WOFF2 subsets are versioned
# deployable assets, so a clean checkout can build without the OTF files.
/src/app/fonts/*.otf

# Original image assets are local authoring inputs. Public WebP files are the
# versioned, deployable assets. Existing tracked inputs stay until the planned
# history-cleanup migration removes them from the repository index.
/assets/images-source/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# claude
.claude/
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/atlas-stage/
!.agents/skills/atlas-stage/**
skills-lock.json

# reference files
.ref/

# local-only material — never enters Git or the static-site build
/.private/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
